<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Jellyfin.Plugin.Plus.Patcher</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.Plus.Patcher</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CA1707;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MediaBrowser.Common">
      <HintPath>$(JellyfinBin)/MediaBrowser.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Controller">
      <HintPath>$(JellyfinBin)/MediaBrowser.Controller.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Model">
      <HintPath>$(JellyfinBin)/MediaBrowser.Model.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Jellyfin.Data">
      <HintPath>$(JellyfinBin)/Jellyfin.Data.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The concrete transcode-job-lifecycle owner (TranscodeManager) for the A/B live-apply
         swap patches (SwapPatches.cs). ITranscodeManager/TranscodingJob/TranscodingJobType live
         in MediaBrowser.Controller.MediaEncoding (MediaBrowser.Controller.dll, above) and need no
         extra reference; only the concrete sealed class lives in this assembly. -->
    <Reference Include="MediaBrowser.MediaEncoding">
      <HintPath>$(JellyfinBin)/MediaBrowser.MediaEncoding.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Tag search (SearchPatches.cs): the EF entities/DbContext the tag query is built from, the
         term normalisation (GetCleanValue/RemoveDiacritics), and EF Core itself. All taken from
         the server's own bin so the types are the ones Jellyfin loaded, never a NuGet copy. -->
    <Reference Include="Jellyfin.Database.Implementations">
      <HintPath>$(JellyfinBin)/Jellyfin.Database.Implementations.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Jellyfin.Extensions">
      <HintPath>$(JellyfinBin)/Jellyfin.Extensions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.EntityFrameworkCore">
      <HintPath>$(JellyfinBin)/Microsoft.EntityFrameworkCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Filter key cache (FilterCacheEngine.cs): raw SQL on Jellyfin's own connection (GetDbConnection). -->
    <Reference Include="Microsoft.EntityFrameworkCore.Relational">
      <HintPath>$(JellyfinBin)/Microsoft.EntityFrameworkCore.Relational.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Scaled JPEG decode (ScaledDecodePatches.cs): SKCodec/SKBitmap, the assembly Jellyfin.Drawing.Skia uses. -->
    <Reference Include="SkiaSharp">
      <HintPath>$(JellyfinBin)/SkiaSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.EntityFrameworkCore.Abstractions">
      <HintPath>$(JellyfinBin)/Microsoft.EntityFrameworkCore.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
